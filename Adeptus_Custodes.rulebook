      },
      "Battle Trait§Not a Shell Wasted": {
        "keywords": {
          "Tags": [
            "Infantry"
          ]
        },
        "text": "Each time a model within this unit makes a ranged attack that targets a unit that contains 10 or more models, that attack has the [SUSTAINED HITS 1] ability."
      },
      "Battle Trait§On Gilded Wings": {
