      "Crusade Badge§Champion of the T’au’va": {
        "text": "You have taken over twelve or more planets.\nYou have won six or more battles.\nAt least one CHARACTER unit from your Order of Battle has reached the Heroic rank."
      },
      "Crusade Badge§Devotee of the T’au’va": {
        "text": "You have taken over four or more planets and used the Set Up Supply Lines Requisition once.\nYou have won two or more battles."
      },
      "Crusade Badge§Hero of the T’au’va": {
        "text": "You have taken over twenty or more planets.\nYou have won ten or more battles.\nAt least one CHARACTER unit from your Order of Battle has reached the Legendary rank."
      },
      "Crusade Relic§Seismic Destabiliser": {
        "rules": {
          "notAllowed": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "disallowed",
                    "items"
                  ]
                ],
                "value": "Crusade Relic§Seismic Destabiliser"
              }
            ],
            "evals": [
              {
                "actionable": true,
                "contains": true,
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Character"
              }
            ],
            "evaluate": "AND",
            "failState": "pass"
          }
        },
        "text": "At the start of your Shooting phase, select one enemy unit within 12\" of the bearer that is not fully visible to the bearer due to intervening terrain or because it is within a terrain feature. Roll one D6, adding 2 to the result if the unit is on or within a ruins terrain feature: on a 3-5, that unit suffers D3 mortal wounds; on a 6+, that unit suffers 3 mortal wounds."
      },
      "Detachment§Advanced Acquisition Cadre": {
        "keywords": {
          "Role": [
            "Reconnaissance"
          ]
        },
        "stats": {
          "Detachment Points": {
            "value": 1
          }
        },
        "text": "**EXPERT FIELDCRAFT**\n\nIn your Shooting phase, when a friendly **PATHFINDER TEAM/ STEALTH BATTLESUITS** unit is **selected to shoot**, those ranged attacks do not prevent your unit from being **hidden**.",
