        "rules": {
          "Maximum 1 grenade launcher": {
            "evals": [
              {
                "actionable": true,
                "max": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "tracked",
                    "grenade"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          },
          "Maximum 1 model with drones": {
            "evals": [
              {
                "actionable": true,
                "max": 1,
                "not": false,
                "operator": "SUM",
                "paths": [
                  [
                    "{self}",
                    "tally",
                    "Pathfinders with Drones"
                  ],
                  [
                    "{self}",
                    "tally",
                    "Pathfinder Shas’ui with Drones"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          },
          "Maximum 3 Special Weapons": {
            "evals": [
              {
                "actionable": true,
                "max": 3,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "tracked",
                    "specialweapon"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          },
          "Must have exactly 1 Shas’ui": {
            "evals": [
              {
                "actionable": true,
                "max": 1,
                "min": 1,
                "not": false,
                "operator": "SUM",
                "paths": [
                  [
                    "{self}",
                    "tally",
                    "Pathfinder Shas’ui with Drones"
                  ],
                  [
                    "{self}",
                    "tally",
                    "Pathfinder Shas’ui"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          },
          "Must have exactly 10 models": {
            "evals": [
              {
                "actionable": true,
                "max": 10,
                "min": 10,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "tally",
                    "Model"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        },
