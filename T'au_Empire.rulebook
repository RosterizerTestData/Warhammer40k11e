      "Enhancement§Unmasking Suite (Upgrade)": {
        "keywords": {
          "Keywords": [
            "Advanced Acquisition Cadre"
          ],
          "Tags": [
            "Upgrade"
          ]
        },
        "stats": {
          "Points": {
            "value": 15
          }
        },
        "text": "**GHOSTKEEL BATTLESUIT**/**PATHFINDER TEAM**/**STEALTH BATTLESUITS** unit only. When this unit is **selected to shoot**, you can select one enemy unit within 24\" of this unit. That enemy unit has +9\" **detection range** until this unit has shot.",
        "removed": {
          "keywords": {
            "Tags": [
              "Character Only"
            ]
          }
        },
        "aspects": {
          "Unique": false
        },
        "rules": {
          "Ghostkeel Battlesuit/Pathfinder Team/Stealth Battlesuits unit only.": {
            "evals": [
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Ghostkeel Battlesuit"
              },
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Pathfinder Team"
              },
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Stealth Battlesuits"
              },
              {
                "actionable": true,
                "not": false,
                "operator": "OR",
                "value": true,
                "paths": [
                  [
                    "{this}",
                    "evals",
                    "0",
                    "result",
                    "truthy"
                  ],
                  [
                    "{this}",
                    "evals",
                    "1",
                    "result",
                    "truthy"
                  ],
                  [
                    "{this}",
                    "evals",
                    "2",
                    "result",
                    "truthy"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        }
      },
      "Stratagem§Guided By Unity": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **T’AU EMPIRE** unit (excluding **KROOT/VESPID STINGWINGS** units) is **selected to shoot**.\n\n**TARGET:** That **T’AU EMPIRE** unit.\n\n**EFFECT:** Your unit’s ranged attacks that target a unit within 9\" of a friendly **KROOT/VESPID STINGWINGS** unit have **[LETHAL HITS]**.",
        "keywords": {
          "Keywords": [
            "T’au Empire",
            "Auxiliary Cadre"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Marker Beacon": {
        "text": "**WHEN:** End of your Movement phase.\n\n**TARGET:** One friendly **PATHFINDER TEAM/STEALTH BATTLESUITS** unit.\n\n**EFFECT:** Select one **objective** your unit is controlling. That **objective** is **secured**.",
        "keywords": {
          "Keywords": [
            "T’au Empire",
            "Advanced Acquisition Cadre"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        }
      },
      "Stratagem§Microdrone Support": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **PATHFINDER TEAM/STEALTH BATTLESUITS** unit **starts an action**.\n\n**TARGET:** That **PATHFINDER TEAM/STEALTH BATTLESUITS** unit.\n\n**EFFECT:** That **action** does not prevent your unit from being **eligible to shoot**.",
        "keywords": {
          "Keywords": [
            "T’au Empire",
            "Advanced Acquisition Cadre"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Autoreactive Camouflage": {
        "text": "**WHEN:** Your opponent’s Shooting phase, when an enemy unit targets a friendly **PATHFINDER TEAM/ STEALTH BATTLESUITS** unit, if that friendly unit is **hidden**.\n\n**TARGET:** That **PATHFINDER TEAM/STEALTH BATTLESUITS** unit.\n\n**EFFECT:** Your unit has +1 **Sv**.",
        "keywords": {
          "Keywords": [
            "T’au Empire",
            "Advanced Acquisition Cadre"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
