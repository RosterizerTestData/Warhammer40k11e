        "rules": {
          "applyTanglebombs": {
            "actions": [
              {
                "actionType": "modify",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "traits",
                    "item",
                    "Model§Kroot Carnivore",
                    "quantity"
                  ]
                ],
                "value": [
                  "{this}",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ]
              },
              {
                "actionType": "add",
                "iterations": [
                  "{self}",
                  "stats",
                  "Tanglebombs",
                  "value"
                ],
                "paths": [
                  [
                    "{self}",
                    "traits"
                  ]
                ],
                "value": {
                  "item": "Model§Kroot Carnivore",
                  "stats": {
                    "Loadout": {
                      "dynamic": false,
                      "value": "Tanglebomb launcher"
                    }
                  }
                }
              },
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Tanglebombs",
                    "max"
                  ]
                ],
                "value": [
                  "{self}",
                  "rules",
                  "count1in10",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ]
              }
            ],
            "evals": [
              {
                "actionable": true,
                "equation": {
                  "operator": "T*O",
                  "value": -1
                },
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Tanglebombs",
                    "value"
                  ]
                ],
                "value": 0
              }
            ],
            "evaluate": "AND",
            "failState": "pass",
            "order": 100
          },
          "Increase leaders": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Leader",
                    "max"
                  ]
                ],
                "value": 2
              }
            ],
            "evals": [
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "tally",
                    "Kroot War Shaper"
                  ]
                ]
              },
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "tally",
                    "Kroot Trail Shaper"
                  ]
                ]
              },
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "tally",
                    "Kroot Flesh Shaper"
                  ]
                ]
              }
            ],
            "evaluate": "OR",
            "failState": "pass"
          },
          "Kroot Detatchment": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "maxQty",
                    "value"
                  ]
                ],
                "value": 6
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
