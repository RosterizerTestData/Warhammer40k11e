      "Stratagem§Courageous Stand": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Questoris Companions"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase or the Fight phase, just after an enemy unit has selected its targets.\n\n**TARGET:** One **IMPERIAL KNIGHTS TITANIC** unit from your army that was selected as the target of one or more of the attacking unit’s attacks.\n\n**EFFECT:** Until the end of the phase, models in your unit have the Feel No Pain 6+ ability."
      },
      "Stratagem§Drive Them Out!": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase or the Fight phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that has not been selected to shoot or fight this phase.\n\n**EFFECT:** Until the end of the phase, each time a model in your unit makes an attack that targets an enemy unit on your defensive line, an unmodified Hit roll of 5+ scores a Critical Hit."
      },
      "Stratagem§Driven by the Past": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Questoris Companions"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Charge"
          ]
        },
        "text": "**WHEN:** Your Charge phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS TITANIC** unit from your army.\n\n**EFFECT:** Until the end of the turn, your unit is eligible to declare a charge in a turn in which it Advanced."
      },
      "Stratagem§Exemplar's Wisdom": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Spearhead-At-Arms"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase, just after an **IMPERIAL KNIGHTS TITANIC** model from your army has shot.\n\n**TARGET:** That **IMPERIAL KNIGHTS TITANIC** model, and one or more friendly **ARMIGER** models affected by that model’s Bondsman ability.\n\n**EFFECT:** Select one enemy unit hit by one or more of those attacks. Until the end of the phase, each time one of your **ARMIGER** models makes an attack that targets that enemy unit, improve the Armour Penetration characteristic of that attack by 1."
      },
      "Stratagem§Flanking Manoeuvres": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** End of your opponent’s Fight phase.\n\n**TARGET:** One **ARMIGER** unit from your army that is within 9\" of one or more battlefield edges and not within Engagement Range of one or more enemy units.\n\n**EFFECT:** Remove your unit from the battlefield and place it into Strategic Reserves."
      },
      "Stratagem§Fortress of Intimidation": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Charge"
          ]
        },
        "text": "**WHEN:** Start of your opponent’s Charge phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS TITANIC** unit from your army that is on your defensive line.\n\n**EFFECT:** Until the end of the phase, each time an enemy unit selects your unit as a target of a charge, that unit must take a Battle-shock test, subtracting 1 from the result."
      },
      "Stratagem§Full Tilt": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Wargear"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        },
        "text": "**WHEN:** Your Movement phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army.\n\n**EFFECT:** Until the end of the phase, if your unit Advances, do not make an Advance roll for it. Instead, until the end of the phase, add 6\" to the Move characteristic of models in your unit, or 9\" instead if your unit is an **ARMIGER** or **DESTRIER** unit."
      },
      "Stratagem§Hero's Tread": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Questoris Companions"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Command"
          ]
        },
        "text": "**WHEN:** End of your Command phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS TITANIC** model from your army that is within range of an objective marker you control.\n\n**EFFECT:** Your Level of Control over that objective marker is 5 (unless it would otherwise be higher), until your opponent’s Level of Control over that objective marker is greater than yours at the end of a phase."
      },
      "Stratagem§Lancebreaker": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** Fight phase, just after an enemy unit has selected its targets.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that was selected as the target of one or more of the attacking unit’s attacks and is on your defensive line.\n\n**EFFECT:** Until the end of the phase, each time an attack targets your unit, if the Strength characteristic of that attack is greater than the Toughness characteristic of your unit, subtract 1 from the Wound roll."
      },
      "Stratagem§Let Duty Be Your Shield": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Spearhead-At-Arms"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase, just after an enemy unit has selected its targets.\n\n**TARGET:** One **ARMIGER** unit from your army that was selected as the target of one or more of the attacking units attacks.\n\n**EFFECT:** Until the end of the phase, each time an attack targets your unit, worsen the Armour Penetration characteristic of that attack by 1."
      },
      "Stratagem§Mantle of the Mentor": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Spearhead-At-Arms"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Start of your Shooting phase.\n\n**TARGET:** One **ARMIGER** model from your army, or one **IMPERIAL KNIGHTS TITANIC** model from your army, and one or more friendly **ARMIGER** models affected by that model’s Bondsman ability.\n\n**EFFECT:** Until the end of the phase, your **ARMIGER** models are eligible to shoot in a turn in which they Fell Back."
      },
      "Stratagem§Marshal the Defence": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        },
        "text": "**WHEN:** Your Movement phase.\n\n**TARGET:** Up to two **IMPERIAL KNIGHTS** units from your army that have not been selected to move this phase.\n\n**EFFECT:** Until the end of the phase, add 3\" to the Move characteristic of models in your units."
      },
      "Stratagem§Moment of Glory": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Questoris Companions"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** Fight phase, just before an **IMPERIAL KNIGHTS TITANIC** unit from your army Consolidates.\n\n**TARGET:** That **IMPERIAL KNIGHTS TITANIC** unit.\n\n**EFFECT:** Until the end of the phase, each time your unit Consolidates, models in it can move an additional 3\" provided your unit can end that move within Engagement Range of one or more enemy units."
      },
      "Stratagem§Noble Sacrifice": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Any"
          ]
        },
        "text": "**WHEN:** Any phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that was just destroyed. You can target that unit with this Stratagem even though it was just destroyed.\n\n**EFFECT:** Your unit’s Deadly Demise ability inflicts mortal wounds on a D6 roll of 4+, adding 1 to the result if it is an **ARMIGER** unit, instead of only a 6."
      },
      "Stratagem§Omnissiah's Grace": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Questor Forgepact"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Any"
          ]
        },
        "text": "**WHEN:** Any phase, when a friendly **IMPERIAL KNIGHTS** unit suffers a **mortal wound**.\n\n**TARGET:** That **IMPERIAL KNIGHTS** unit.\n\n**EFFECT:** Your unit has **Feel No Pain 5+** against **mortal wounds**."
      },
      "Stratagem§Point-Blank Barrage": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that has not been selected to shoot this phase.\n\n**EFFECT:** Until the end of the phase, when making ranged attacks with Blast weapons, models in your unit can target enemy units within Engagement Range of your unit (provided no other friendly units are also within Engagement Range of that enemy unit). In addition, until the end of the phase, your unit does not suffer the penalty to its Hit rolls for being within Engagement Range of one or more enemy units, but each time a model in your unit makes an attack with a Blast weapon that targets a unit within Engagement Range of your unit, on an unmodified Hit roll of 1, your unit suffers 1 mortal wound after all of its attacks have been resolved."
      },
      "Stratagem§Rotate Ion Shields": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Valourstrike Lance"
          ],
          "Category": [
            "Wargear"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase, just after an enemy unit has selected its targets.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that was selected as the target of one or more of the attacking unit’s attacks.\n\n**EFFECT:** Until the end of the phase, models in your unit have a 4+ invulnerable save."
      },
      "Stratagem§Run Them Through!": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Valourstrike Lance"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** Fight phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that has not been selected to fight this phase.\n\n**EFFECT:** Until the end of the phase, melee weapons equipped by your models have the **[LANCE]** ability."
      },
      "Stratagem§Shoulder the Burden": {
        "keywords": {
          "Phase": [
            "Command"
          ],
          "Turn": [
            "Yours"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Keywords": [
            "Imperial Knights",
            "Noble Lance"
          ]
        },
        "stats": {
          "Command Cost": {
            "value": 2
          }
        },
        "text": "**WHEN**: Your Command phase.\n\n**TARGET**: One Imperial Knights model from your army that has lost one or more wounds.\n\n**EFFECT**: Until the start of your next Command phase, improve your model’s Move, Toughness, Save, Leadership and Objective Control characteristics by 1 and each time your model makes an attack, add 1 to the Hit roll.\n\n**RESTRICTIONS**: You can only use this Stratagem once per battle. If your army is Honoured, you can use this Stratagem one additional time."
      },
      "Stratagem§Squires of the Hunt": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Spearhead-At-Arms"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** End of your opponent’s Fight phase.\n\n**TARGET:** One **ARMIGER** model from your army, or one **IMPERIAL KNIGHTS TITANIC** model from your army, and one or more friendly **ARMIGER** models affected by that model’s Bondsman ability.\n\n**EFFECT:** For each of your **ARMIGER** models that is within 9\" of one or more battlefield edges and not within Engagement Range of one or more enemy units, remove that **ARMIGER** model from the battlefield and place it into Strategic Reserves."
      },
      "Stratagem§Squires’ Duty": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Noble Lance"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Opponent’s",
            "Yours"
          ]
        },
        "text": "**WHEN**: The start of your Shooting phase or the start of the Fight phase.\n\n**TARGET**: Two or more Armiger models from your army and one enemy unit that is an eligible target for all of those Armiger models.\n\n**EFFECT**: Until the end of the phase, when resolving attacks that target that enemy unit, improve the Strength and Armour Penetration characteristics of weapons equipped by those Armiger models by 1. If your army is Honoured, until the end of the phase, add 1 to the Damage characteristic of those weapons as well"
      },
      "Stratagem§Steadfast Superiority": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** Fight phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that is within Engagement Range of one or more enemy units, that is on your defensive line and that has not already been selected to fight this phase.\n\n**EFFECT:** Until the end of the phase, each time a model in your unit makes an attack, you can re-roll the Hit roll."
      },
      "Stratagem§Strength From Exile": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase or the Fight phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that has not been selected to shoot or fight this phase.\n\n**EFFECT:** Until the end of the phase, each time a model in your unit makes an attack, if there are no other friendly units within 9\" of your unit, re-roll a Hit roll of 1 and re-roll a Wound roll of 1."
      },
      "Stratagem§Survivor of Strife": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Freeblade Company"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase, just after an enemy unit has selected its targets.\n\n**TARGET:** One **IMPERIAL KNIGHTS** unit from your army that was selected as the target of one or more of the attacking unit’s attacks.\n\n**EFFECT:** Until the end of the phase, each time an attack targets your unit, if the Strength characteristic of that attack is greater than the Toughness characteristic of your unit, subtract 1 from the Wound roll."
      },
      "Stratagem§Tactical Foil": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Valourstrike Lance"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Movement"
          ]
        },
        "text": "**WHEN:** Your opponent’s Movement phase, just after an enemy unit ends a Normal, Advance or Fall Back move.\n\n**TARGET:** One **IMPERIAL KNIGHTS** model from your army that is within 8\" of that unit.\n\n**EFFECT:** Your model can make a Normal move of up to D6\"."
      },
      "Stratagem§Thin Their Ranks": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Spearhead-At-Arms"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Start of your Shooting phase.\n\n**TARGET:** One **ARMIGER** model from your army, or one **IMPERIAL KNIGHTS TITANIC** model from your army, and one or more friendly **ARMIGER** models affected by that model’s Bondsman ability.\n\n**EFFECT:** Until the end of the phase, ranged weapons equipped by your **ARMIGER** models have the **[RAPID FIRE 1]** ability."
      },
      "Stratagem§Thunderstomp": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Valourstrike Lance"
          ],
          "Phase": [
            "Fight"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Fight phase.\n\n**TARGET:** One **IMPERIAL KNIGHTS** model from your army that has not been selected to fight this phase.\n\n**EFFECT:** Until the end of the phase, the Attacks characteristic of any armoured Feet melee weapons equipped by your model is 8, the Attacks characteristic of any titanic Feet melee weapons equipped by your model is 12, and improve the Armour Penetration characteristic of those weapons by 1."
      },
      "Stratagem§Titanic Bombardment": {
        "keywords": {
          "Keywords": [
            "Imperial Knights",
            "Gate Warden Lance"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
