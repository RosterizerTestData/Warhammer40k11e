                    "traits"
                  ]
                ],
                "value": "Stratagem§Goaded to Fury"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
                    "item",
                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§Trail of Destruction"
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass"
          }
        }
      },
      "Detachment§Butchers Of Khorne": {
        "keywords": {
          "Role": [
            "Take And Hold"
          ]
        },
        "stats": {
          "Detachment Points": {
            "value": 1
          }
        },
        "text": "**ADAMANTINE AVALANCHE**\n\nAt the start of the Fight phase, if a friendly **TERMINATOR SQUAD** unit is **engaged**, make a **Blessings of Khorne roll** and use the results to activate one **Blessing of Khorne**. Until the end of the phase, that **Blessing of Khorne** is active for friendly **TERMINATOR SQUAD** units in addition to any other **Blessings of Khorne** that are currently active.",
        "rules": {
          "assignStratagems": {
