      "Detachment§Brazen Engines": {
        "keywords": {
          "Role": [
            "Disruption"
          ]
        },
        "stats": {
          "Detachment Points": {
            "value": 1
          }
        },
        "text": "**RAMPAGING TERRORS**\n\nFriendly **DAEMON VEHICLE** units have the following ability:\n\n**\u0007Terror of Khorne:** At the start of the Fight phase, you can select one enemy unit **engaged** with this unit. That enemy unit makes a **battle-shock roll**, with -1 to that **battle-shock roll**. You cannot select the same enemy unit for this effect more than once per phase.\n\nThis **detachment** has the **ONSLAUGHT** tag and cannot be taken with another **ONSLAUGHT** **detachment**.",
        "rules": {
          "assignStratagems": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
                    "item",
                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§Apoplectic Clarity"
              },
