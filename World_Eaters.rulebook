                    "Stratagems§Stratagems",
                    "traits"
                  ]
                ],
                "value": "Stratagem§In the Shadow of Brass Idols"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "traits",
