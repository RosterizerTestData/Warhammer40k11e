                  ]
                ],
                "value": "✓"
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass",
            "order": 20
          }
        }
      },
      "Ability§Swooping Predator (DP)": {
        "aspects": {
          "Label": "Swooping Predator"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model ends a Normal or Advance move, you can select one enemy unit that it moves over during that move and roll six D6: for each 4+, that enemy unit suffers 1 mortal wound."
      },
      "Ability§The Betrayer": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the end of your Charge phase, if this model is leading a unit and that unit is not within Engagement Range of one or more enemy units, you must take a Leadership test for this model. If that test is failed, one Bodyguard model in that unit is destroyed."
      },
      "Ability§The Blood God's Favour": {
        "keywords": {
          "Keywords": [
            "Primarch",
            "Wrathful Presence"
          ]
        },
        "text": "Each time you make a Blessings of Khorne roll, if this model is on the battlefield, you can re-roll up to six of the D6 rolled."
      },
      "Ability§The Scent of Blood": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model declares a charge that targets one or more units below Starting Strength, add 1 to the Charge roll. If one or more of the targets of that charge are Below Half-strength, add 2 to the Charge roll instead."
      },
      "Ability§To Slake Its Rage": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This unit is eligible to declare a charge in a turn in which it advanced."
      },
      "Ability§Unleash Wrath": {
        "text": "At the end of your opponent's Movement phase, you can select one enemy unit that was set up on the battlefield within 12\" of this model; this model can then either:\n\n- Shoot at that unit, but only if it is an eligible target.\n\n- Declare a charge against that unit (note that even if this charge is successful, this model does not receive any Charge bonus this turn)."
      },
      "Ability§Wrathful Presence": {
        "assets": {
          "traits": [
            "Ability§The Blood God's Favour",
            "Ability§Overwhelming Wrath (Aura)",
            "Ability§Driven by Ultimate Rage (Aura)"
          ]
        },
        "keywords": {
          "Keywords": [
            "Primarch"
          ]
        },
        "text": "At the start of the battle round, select one Wrathful Presence ability. Until the start of the next battle round, this model has that ability."
      },
