                    "truthy"
                  ],
                  [
                    "{this}",
                    "evals",
                    "1",
                    "result",
                    "truthy"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        }
      },
      "Enhancement§Warp Syphon": {
        "keywords": {
          "Keywords": [
