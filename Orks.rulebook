        "stats": {
          "Points": {
            "value": 25
          }
        },
        "text": "**WAGON** unit only. While a **BIG MEK** model is embarked within this unit:\n\n- This unit’s ranged attacks have **[IGNORES COVER]**.\n\n- If this unit is **riled up**, this unit’s ranged attacks have **[SUSTAINED HITS 1]**.",
        "removed": {
          "keywords": {
            "Tags": [
              "Character Only"
            ]
          }
        },
        "aspects": {
          "Unique": false
        }
      },
      "Enhancement§Targetin’ Squigs": {
        "stats": {
          "Points": {
            "value": 20
          }
        },
        "text": "**BIG MEK/BIGBOSS/WARBOSS** model only. This unit’s ranged attacks (excluding **[TORRENT]** attacks) have +3\" **R**.",
        "keywords": {
          "Keywords": [
            "Shoota Boyz"
          ]
        },
        "rules": {
          "BIG MEK/BIGBOSS/WARBOSS model only.": {
            "evals": [
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Big Mek"
              },
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Bigboss"
              },
              {
                "actionable": false,
                "contains": true,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Warboss"
              },
              {
                "actionable": true,
                "not": false,
                "operator": "OR",
                "value": true,
                "paths": [
                  [
                    "{this}",
                    "evals",
                    "0",
                    "result",
                    "truthy"
                  ],
                  [
                    "{this}",
                    "evals",
                    "1",
                    "result",
                    "truthy"
                  ],
                  [
                    "{this}",
                    "evals",
                    "2",
                    "result",
                    "truthy"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        }
      },
