      "Stratagem§’Ere We Go": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Green Tide"
          ],
          "Phase": [
            "Movement"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours"
          ]
        },
        "text": "**WHEN:** Your Movement phase, when a friendly **BEAST SNAGGA BOYZ/BOYZ** unit is **selected to move**.\n\n**TARGET:** That **BEAST SNAGGA BOYZ/BOYZ** unit.\n\n**EFFECT:** Your unit has +2 to **advance rolls**."
      },
      "Stratagem§Armed To Da Teef": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Bully Boyz"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase or the Fight phase, when a friendly **MEGANOBZ/NOBZ** unit is **selected to attack**.\n\n**TARGET:** That **MEGANOBZ/NOBZ** unit.\n\n**EFFECT:** Your unit’s attacks can:\n\n- Re-roll **hit rolls** of 1.\n\n- If your unit is **riled up**, re-roll **hit rolls**."
      },
      "Stratagem§Dakkastorm": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Kult of Speed"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your Shooting phase, when a friendly **SPEED FREEKS** unit is **selected to shoot**.\n\n**TARGET:** That **SPEED FREEKS** unit.\n\n**EFFECT:** Your unit’s ranged attacks have **[SUSTAINED HITS 1]**."
      },
      "Stratagem§Hulking Brutes": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Bully Boyz"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase, when an enemy unit targets a friendly **MEGANOBZ/NOBZ** unit.\n\n**TARGET:** That **MEGANOBZ/NOBZ** unit.\n\n**EFFECT:** Ranged attacks that target your unit with a **S** greater than your unit’s **T** have -1 to **wound rolls**."
      },
      "Stratagem§Instinctive Hunters": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Da Big Hunt"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** End of your opponent’s Fight phase.\n\n**TARGET:** One friendly **unengaged** **BEAST SNAGGA** unit within 6\" of a battlefield edge.\n\n**EFFECT:** Place your unit in **strategic reserves**."
      },
      "Stratagem§Long, Uncontrolled Bursts": {
        "keywords": {
          "Category": [
            "Battle Tactic"
          ],
          "Keywords": [
            "Orks",
            "Flyboyz"
          ],
          "Phase": [
            "Shooting"
          ],
          "Turn": [
            "Yours"
          ]
        },
        "text": "**WHEN:** Your Shooting phase, when a friendly **ORKS AIRCRAFT/DEFFKOPTAS** unit is **selected to shoot**.\n\n**TARGET:** That **ORKS AIRCRAFT/DEFFKOPTAS** unit.\n\n**EFFECT:** When your unit’s ranged attacks target a **FLY** unit, those attacks can re-roll **hit rolls**."
      },
      "Stratagem§Orks Is Never Beaten": {
        "keywords": {
          "Keywords": [
            "Orks",
            "War Horde"
          ],
          "Phase": [
            "Fight"
          ],
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Fight phase, when an enemy unit targets a friendly **ORKS** unit (excluding **TITANIC** units).\n\n**TARGET:** That **ORKS** unit.\n\n**EFFECT:** When a model in your unit is **destroyed**, if your unit has not been **selected to fight** this phase, roll one D6, with +1 to that roll if your unit is **riled up**:\n\n- On a 4+, do not remove that model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), that model is removed from the battlefield."
      },
      "Stratagem§Speediest Freeks": {
        "keywords": {
          "Category": [
            "Strategic Ploy"
          ],
          "Keywords": [
            "Orks",
            "Kult of Speed"
          ],
          "Phase": [
            "Shooting"
          ],
          "Turn": [
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Your opponent’s Shooting phase, when an enemy unit targets a friendly **SPEED FREEKS** unit.\n\n**TARGET:** That **SPEED FREEKS** unit.\n\n**EFFECT:** Ranged attacks that target your unit fail on an unmodified **hit roll** of 1‑3."
      },
      "Stratagem§Too Arrogant To Die": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Bully Boyz"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        },
        "text": "**WHEN:** Fight phase, when an enemy unit targets a friendly **MEGANOBZ/NOBZ** unit.\n\n**TARGET:** That **MEGANOBZ/NOBZ** unit.\n\n**EFFECT:** When a model in your unit is **destroyed**, if your unit has not been **selected to fight** this phase, roll one D6, with +1 to that roll if your unit is **riled up**:\n\n- On a 4+, do not remove that model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), that model is removed from the battlefield."
      },
      "Stratagem§Unbridled Carnage": {
        "keywords": {
          "Keywords": [
            "Orks",
            "Green Tide"
          ],
          "Phase": [
            "Fight"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Fight phase, when a friendly **BOYZ** unit that made a **charge move** this turn is **selected to fight**.\n\n**TARGET:** That **BOYZ** unit.\n\n**EFFECT:** Your unit’s melee attacks have +1 **A**."
      },
      "Stratagem§Where D’ya Fink You’re Going?": {
        "keywords": {
          "Category": [
            "Strategic Ploy"
          ],
          "Keywords": [
            "Orks",
            "Da Big Hunt"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Movement"
          ]
        },
        "text": "**WHEN:** Your opponent’s Movement phase, when an enemy unit is selected to make a **fall-back move**, if that enemy unit is **engaged** with a friendly **BEAST SNAGGA** unit.\n\n**TARGET:** That **BEAST SNAGGA** unit.\n\n**EFFECT:** When an enemy unit **engaged** with your unit is selected to make a **fall-back move**, that enemy unit must use the **desperate escape **mode. If that enemy unit is a **MONSTER/VEHICLE** unit, that enemy unit makes three additional **hazard rolls** for each **BEAST SNAGGA** unit it is **engaged** with, with -1 from those **hazard rolls** if that enemy unit is **battle-shocked**."
      },
