        "text": "While this model is leading a unit, models in that unit have the Deep Strike ability."
      },
      "Ability§Thievin’ Scavengers": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of your Movement phase, roll one D6 for each objective marker you control that has one or more units from your army with this ability within range of it (excluding Battle-shocked units). If one or more of those rolls is a 4+, you gain 1CP."
      },
      "Ability§Throttlerokkit Shokka Engine": {
        "assets": {
          "traits": [
            "Ability§Turbo Engine",
            "Ability§Shokk Attack Engine",
            "Ability§Pulse Jet"
          ]
        },
        "text": "In your Command phase, select one of the abilities in the Throttlerokkit Shokka Engine section. Until the start of your next Command phase, this model has that ability"
      },
      "Ability§Thundering Stampede": {
        "text": "While this model is leading a unit, add 1 to Charge rolls made for that unit."
      },
      "Ability§Trample": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model is selected to fight, you can select one enemy unit within Engagement Range of it and roll one D6, adding 2 to the result if this model made a Charge move this turn: on a 4-5, that enemy unit suffers D3 mortal wounds; on a 6+, that enemy unit suffers 3 mortal wounds."
      },
      "Ability§Trophy Hunters": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit declares a charge, you can re-roll the Charge roll."
      },
      "Ability§Turbo Engine": {
        "text": "This unit is eligible to declare a charge in a turn in which it Advanced or Fell Back."
      },
      "Ability§Twin -linked": {},
      "Ability§Unstable Oracle": {
        "text": "While this model is leading a unit, add 2 to the Attacks characteristic of this model’s Eyez of Mork weapon for every 5 models in that unit (rounding down), but while that unit contains 10 or more models, that weapon has the [HAZARDOUS] ability."
      },
      "Ability§Waaagh!": {
        "keywords": {
          "Keywords": [
            "Faction"
          ]
        },
        "text": "If your Army Faction is Orks, once per battle, at the start of your Command phase, you can call a Waaagh!. If you do, until the start of your next Command phase, the Waaagh! is active for your army and:\n\n* Orks units from your army are eligible to declare a charge in a turn in which they Advanced.\n\n* Add 1 to the Strength and Attacks characteristics of melee weapons equipped by Orks models from your army.\n\n* Orks models from your army have a 5+ invulnerable save."
      },
      "Ability§Waaagh! Banner": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "* This unit has a 5+ invulnerable save.\n\n* While the Waaagh! is active for this unit, this unit has +1 Toughness."
      },
      "Ability§Waaagh! Effigy (aura)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a friendly Orks unit is within 12″ of this model, each time you take a Battle-shock test for that unit, add 1 to that test."
      },
      "Ability§Waaagh! Energy": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, add 1 to the Strength and Damage characteristics of this model’s ’Eadbanger weapon for every 5 models in that unit (rounding down), but while that unit contains 10 or more models, that weapon has the [HAZARDOUS] ability."
      },
      "Ability§Waagh! Wazdakka": {
        "text": "If this model is your Warlord, Warbiker units from your army have the Battleline keyword."
      },
      "Ability§Walking Bastion": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model does not suffer the penalty to its Hit rolls for making ranged attacks while enemy units are within Engagement Range of it."
      },
      "Ability§Wall of Dakka": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack that targets a unit within half range, add 1 to the Hit roll."
      },
      "Ability§Wild Ride": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "You can ignore any or all modifiers to this unit’s Move characteristic and to Advance and Charge rolls made for this unit."
      },
      "Ability§Workshop": {
        "text": "When this Fortification is set up, all parts of it must be set up within 1” of another part. At the end of your Movement phase, each friendly Orks Vehicle model within\n12” of this Fortification can regain up to D3 lost wounds (roll separately for each model). Each model can only be affected by this ability once per turn."
      },
