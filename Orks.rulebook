    "assetCatalog": {
      "Ability§’ere We Go (aura)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a friendly Beast Snagga unit is within 6″ of this model, you can re-roll Charge rolls made for that unit."
      },
      "Ability§Aerial Deployment": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "If this model starts the game in Strategic Reserves, it can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules."
      },
      "Ability§Attached Unit (Breaka Boyz)": {
        "aspects": {
          "Label": "Attached Unit"
        },
        "text": "If a Character unit from your army with the Leader ability can be attached to a Boyz unit, it can be attached to this unit instead."
      },
      "Ability§Attached Unit (Tankbustas)": {
        "aspects": {
          "Label": "Attached Unit"
        },
        "text": "If a **Character** unit from your army with the Leader ability can be attached to a **Lootas** unit, it can be attached to this unit instead."
      },
      "Ability§Beastboss": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time a model in that unit makes a melee attack, add 1 to the Hit roll."
      },
      "Ability§Beastly Rage": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a Charge move, until the end of the turn, melee weapons it is equipped with have the [DEVASTATING WOUNDS] ability."
      },
      "Ability§Big An’ Shooty": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack, if the Waaagh! is active for your army, add 1 to the Hit roll."
      },
      "Ability§Big An’ Stompy": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a melee attack, if the Waaagh! is active for your army, add 1 to the Hit roll."
      },
      "Ability§Big Booms": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, just after selecting a target for this model’s supa-kannon, roll one D6 for the target unit and every other unit within 3″ of that unit: on a 5+, the unit being rolled for is struck by a concussive wave. After this model has finished making its attacks against that target unit this phase, each unit struck by a concussive wave this phase suffers D3 mortal wounds."
      },
      "Ability§Big Gunz": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        },
        "text": "Designer’s Note: Place two Grot Crew tokens next to each Mek Gun model when this unit is first set up, removing one each time its Big Gun model loses a wound (a Big Gun model itself is considered to represent its final wound)."
      },
      "Ability§Billowing Fumes (aura)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While an enemy unit (excluding **Monsters** and **Vehicles**) is within 6″ of this model, each time a model in that unit makes an attack, subtract 1 from the Hit roll."
      },
      "Ability§Bizarrely Resilient": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack targets this model, worsen the Armour Penetration characteristic of that attack by 1."
      },
      "Ability§Blastajet Attack Run": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack that targets a unit that cannot Fly, re-roll a Hit roll of 1."
      },
      "Ability§Bludgeoning Cheer": {
        "text": "Each time this model ends a Normal, Advance, Fall Back or Charge move, select one enemy unit within 3″ of this model and roll six D6: for each 4+, that enemy unit suffers 1 mortal wound. That enemy unit must then take\na Battle-shock test."
      },
      "Ability§Bodyguard": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        },
        "text": "If this unit has a Starting Strength of 20, you can attach up to two Leader units to it instead of one (but only if one of those is a Warboss unit). If you do, and this unit is destroyed, the Leader units attached to it become separate units with their original Starting Strengths."
      },
      "Ability§Bomb Squigs": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, for each bomb squig this unit has, after this unit ends a Normal move, you can use one Bomb Squig. If you do, select one enemy unit within 12\" and visible to this unit and roll one D6: on a 3+, that enemy unit suffers D3 mortal wounds.\n\n**Designer’s Note:** *Place two Bomb Squig tokens next to the unit, removing one each time this unit uses this ability.*"
      },
      "Ability§Boom Bomb": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model ends a Normal move, you can select one enemy unit it moved over during that move and roll one D6: on a 4+, that unit suffers D6 mortal wounds."
      },
      "Ability§Breakin’ Heads": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This unit’s melee weapons have [SUSTAINED HITS 1]."
      },
      "Ability§Bubblechukka": {
        "text": ""
      },
      "Ability§Burna Bomb": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model ends a Normal move, you can select one enemy unit it moved over during that move. Until the end of the turn, models in that unit cannot have the Benefit of Cover. In addition, roll one D6 for each model in that unit: for each 6, that unit suffers 1 mortal wound."
      },
      "Ability§Buzzer Squigs": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, after this model\nhas shot, select one enemy unit (excluding MONSTERS and VEHICLES) hit by one or more of those attacks made with squig-launchas and roll one D6: on a 4+, until the end of your opponent’s next turn, that enemy unit is hindered. While a unit is hindered, subtract 2″ from its Move characteristic and subtract 2 from Advance and Charge rolls made for it."
      },
      "Ability§Clankin’ Forward": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a Normal, Advance or Fall Back move, it can move over enemy models (excluding Monster and Vehicle models) and terrain features that are 4″ or less in height as if they were not there."
      },
      "Ability§Da Bigger Dey Are, Da Better Dey Drop": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack made with this model’s lifta-droppa destroys an enemy model that has the Deadly Demise ability, that model’s Deadly Demise ability inflicts mortal wounds on a D6 roll of 3+ instead of on a 6."
      },
      "Ability§Da Bigger Dey Iz…": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack that targets a Monster or Vehicle unit, add 1 to the Damage characteristic of that attack. Each time this model makes an attack that targets a Titanic unit, add 2 to the Damage characteristic of that attack instead."
      },
      "Ability§Da Biggest and Da Best": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While the Waaagh! is active for your army, add 4 to the Attacks characteristic of this model’s melee weapons."
      },
      "Ability§Da Biggest Booms": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, just after selecting a target for this model’s krusha kannon, the target unit and every other enemy Infantry unit within 3″ of that unit must take a Battle-shock test."
      },
      "Ability§Da Boss’ Ladz": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a WARBOSS model is leading this unit, each time an attack targets this unit, if the Strength characteristic of that attack is greater than the Toughness characteristic of this unit, subtract 1 from the Wound roll."
      },
      "Ability§Da Jump (psychic)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, at the end of your Movement phase, one Weirdboy from your army can use this ability. If it does, roll one D6: on a 1, that Weirdboy’s unit suffers D6 mortal wounds; on a 2+, remove this Weirdboy’s unit from the battlefield and set it up again anywhere on the battlefield that is more than 9″ horizontally away from all enemy models."
      },
      "Ability§Da Revolushun!": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time a model in that unit makes an attack, add 1 to the Hit roll."
      },
      "Ability§Da Revolushun! xmas": {
        "aspects": {
          "Label": "Da Revolushun!"
        },
        "text": "Once per battle round, at the start of any phase, you can select one friendly **Gretchin** unit that is Battle-shocked and within 12″ of this model. That unit is no longer Battle-shocked."
      },
      "Ability§Dakkablitz": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, while making attacks with this unit, if its blitzkannon targeted a non-MONSTER/VEHICLE unit, that weapon has +6 Attacks."
      },
      "Ability§Dakkastorm": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack, every successful Hit roll scores a Critical Hit."
      },
      "Ability§Dat’s Our Loot!": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Dat’s Our Loot! Each time a model in this unit makes a ranged attack, re-roll a Hit roll of 1. If that attack targets a unit that is within range of an objective marker, you can re-roll the Hit roll instead."
      },
      "Ability§Dead Brutal": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While the Waaagh! is active for your army, this model’s ’uge choppa has a Damage characteristic of 3."
      },
      "Ability§Dead Choppy": {},
      "Ability§Dead Rippy": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "If this model is equipped with 2 dread killsaws, those weapons have the [TWIN-LINKED] ability. If this model is equipped with 2 dread rippa klaws, those weapons have the [TWIN-LINKED] ability."
      },
      "Ability§Ded Glowy Ammo (aura)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While an enemy Infantry unit is within 6″ of this model, subtract 1 from the Toughness characteristic of models in that unit."
      },
      "Ability§Deff From Above": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit ends a Normal move, you can select one enemy unit it moved over during that move and roll one D6 for each model in this unit: for each 4+, that enemy unit suffers 1 mortal wound."
      },
      "Ability§Deranged Snotling Assault": {
        "keywords": {
