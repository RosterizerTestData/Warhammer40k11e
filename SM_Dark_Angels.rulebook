      "Stratagem§In Sacrifice, Victory": {
        "text": "**WHEN:** Any phase, when a friendly **DEATHWING/RAVENWING** unit within range of an **objective** is **destroyed**.\n\n**TARGET:** That **DEATHWING/RAVENWING** unit. You can target that unit with this **stratagem** even though it is **destroyed**.\n\n**EFFECT:** Select one **objective**: \n- That no enemy units (excluding **AIRCRAFT** units) are within range of.\n- That your unit was controlling at the end of the previous phase.That **objective** is **secured**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Any"
          ]
        }
      },
      "Stratagem§Skyborne Surveillance": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **RAVENWING FLY** unit has shot.\n\n**TARGET:** That **RAVENWING FLY** unit.\n\n**EFFECT:** **Visible** enemy units within 6\" of your unit have +3\" **detection range**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Darkflight Pursuit"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§We Are Vengeance": {
        "text": "**WHEN:** Your opponent's Shooting phase, when an enemy unit that targeted a friendly **unengaged** **RAVENWING FLY** unit has shot.\n\n**TARGET:** That **RAVENWING FLY** unit.\n\n**EFFECT:** Your unit can make a **normal move** of up to D3+3\".",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Darkflight Pursuit"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Wings of Shadow": {
        "text": "**WHEN:** Your opponent's Shooting phase, when an enemy unit targets a friendly **RAVENWING FLY/MOUNTED** unit.\n\n**TARGET:** That **RAVENWING FLY/MOUNTED** unit.\n\n**EFFECT:** Your unit has **Stealth**.",
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Darkflight Pursuit"
          ],
          "Turn": [
            "Opponent’s"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
