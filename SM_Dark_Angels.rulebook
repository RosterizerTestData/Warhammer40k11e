      "Stratagem§Armour of Contempt": {
        "keywords": {
          "Keywords": [
            "Inner Circle Task Force",
            "Wrath of the Rock"
          ],
          "Phase": [],
          "Category": [],
          "Turn": []
        },
        "text": ""
      },
      "Stratagem§Duty unto Death": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Inner Circle Task Force"
          ],
          "Phase": [
            "Fight"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Fight phase, when an enemy unit targets a friendly **DEATHWING** unit.\n\n**TARGET:** That **DEATHWING** unit.\n\n**EFFECT:** When a model in your unit is **destroyed**, if your unit has not been **selected to fight** this phase, roll one D6, with +1 to that roll if your unit is **engaged** with an enemy unit within range of your **vowed objective**:\n- On a 4+, do not remove that model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), that model is removed from the battlefield."
      },
      "Stratagem§Inescapable Justice": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Phase": [
            "Fight"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** The Fight phase, when a friendly **ADEPTUS ASTARTES** unit is **selected to fight**.\n\n**TARGET:** That **ADEPTUS ASTARTES** unit.\n\n**EFFECT:** Your unit's melee attacks have **[PRECISION]**."
      },
      "Stratagem§Knights of Iron": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Charge",
            "Movement"
          ]
        },
        "text": "**WHEN:** Your Movement/Charge phase, when a friendly **RAVENWING** unit is **selected to move** or **declares a charge**.\n\n**TARGET:** That **RAVENWING** unit.\n\n**EFFECT:** Your unit has **MOBILE**."
      },
      "Stratagem§Lion’s Will": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Phase": [
            "Command"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ]
        },
        "text": "**WHEN:** Command phase.\n\n**TARGET:** One friendly **ADEPTUS ASTARTES** unit that is within range of an **objective**.\n\n**EFFECT:** Your unit has +1 **OC** until the end of the turn."
      },
      "Stratagem§Relic Teleportarium": {
        "keywords": {
          "Category": [
            "Strategic Ploy"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ],
          "Keywords": [
            "Adeptus Astartes",
            "Inner Circle Task Force"
          ]
        },
        "text": "**WHEN:** Your Movement phase, when a friendly **DEATHWING** unit with the **Deep Strike** ability is selected to make an **ingress move**.\n\n**TARGET:** That **DEATHWING** unit.\n\n**EFFECT:** - Your unit can be set up more than 6” horizontally from all enemy units (instead of more than 8”).\n- Your unit is __not__ **eligible to declare a charge** until the end of this turn."
      },
      "Stratagem§Relics of the Dark Age": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Category": [
            "Strategic Ploy"
          ],
          "Phase": [
            "Shooting"
          ],
          "Turn": [
            "Yours"
          ]
        },
        "text": "**WHEN:** Your Shooting phase, when a friendly **ADEPTUS ASTARTES INFANTRY/MOUNTED** unit is **selected to shoot**.\n\n**TARGET:** That **ADEPTUS ASTARTES INFANTRY/MOUNTED** unit.\n\n**EFFECT:** Your unit’s ranged attacks have +2 **S**."
      },
      "Stratagem§Tactical Mastery": {
        "keywords": {
          "Keywords": [
            "Adeptus Astartes",
            "Wrath of the Rock"
          ],
          "Category": [
            "Battle Tactic"
          ],
          "Phase": [
            "Command"
          ],
          "Turn": [
            "Yours"
          ]
        },
        "text": "**WHEN:** Your Command phase.\n\n**TARGET:** One friendly **DEATHWING/RAVENWING** unit.\n\n**EFFECT:** Select one **combat doctrine**. That **combat doctrine** is active for your unit until the start of your next Command phase."
      },
      "Stratagem§Wrath of the Lion": {
        "keywords": {
          "Category": [
            "Epic Deed"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Charge"
          ],
          "Keywords": [
            "Adeptus Astartes",
            "Inner Circle Task Force"
          ]
        },
        "text": "**WHEN:** Your Charge phase, when a friendly **DEATHWING** unit ends a **charge move**.\n\n**TARGET:** That **DEATHWING** unit.\n\n**EFFECT:** Select one enemy unit **engaged** with your unit. If you do, roll one D6 for each model in your unit **engaged** with that enemy unit:\n- For each 3+, that enemy unit suffers 1 **mortal wound** (to a maximum of 6 **mortal wounds**)."
      },
