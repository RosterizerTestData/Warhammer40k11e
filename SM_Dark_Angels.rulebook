    "assetCatalog": {
      "Ability§Astartes Banner": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains an Ancient, add 1 to the Objective Control characteristic of its models."
      },
      "Ability§Attached Unit": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        }
      },
      "Ability§Braziers of Judgement": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a CHARACTER model is leading this unit, each time an attack targets this unit, subtract 1 from the hit roll."
      },
      "Ability§Cut Off Their Escape": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an enemy unit (excluding Monsters and Vehicles) within Engagement Range of this model’s unit is selected to Fall Back, models in that enemy unit must take Desperate Escape tests as if their unit was Battle-shocked. When doing so, if that enemy unit is also Battle-shocked by other means, subtract 1 from each of those Desperate Escape tests."
      },
      "Ability§DA Astartes Banner": {
        "aspects": {
          "Label": "Astartes Banner"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains an Ancient, add 1 to the Objective Control characteristic of its models."
      },
      "Ability§DA Honour or Death": {
        "aspects": {
          "Label": "Honour or Death"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains a Company Champion, add 1 to Advance and Charge rolls made for this unit and you can target this unit with the Heroic Intervention Stratagem for 0CP."
      },
      "Ability§DA Narthecium": {
        "aspects": {
          "Label": "Narthecium"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains an Apothecary, in your Command phase, you can return 1 destroyed model (excluding Character models and Invader ATV models) to this unit."
      },
      "Ability§Dark Angels Bodyguard": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is within 3″ of one or more friendly Adeptus Astartes Infantry units, this model has the Lone Operative ability."
      },
      "Ability§Deathwing": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit makes an attack, you can ignore any or all modifiers to that attack’s Ballistic Skill or Weapon Skill characteristics and/or to the Hit roll. In addition, each time a model in this unit makes an attack that targets the enemy unit you selected at the start of your Command phase for the Oath of Moment ability, add 1 to the Hit roll."
      },
      "Ability§Engulfing Fear (Psychic)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, you can select one enemy unit within 18″ of this model. That enemy unit must take a Battle-shock test."
      },
      "Ability§Enmity for the Unworthy": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit makes an attack that targets a CHARACTER unit, add 1 to the hit roll."
      },
      "Ability§Exemplar of Hate": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time a model in that unit makes a melee attack, you can re-roll the Hit roll."
      },
      "Ability§Feared Interrogator": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of the Fight phase, each enemy Character unit within 6″ of this model must take a Battle-shock test, subtracting 1 from that test when they do. In addition, each time this model destroys an enemy Character model with a melee attack, you gain 1CP."
      },
      "Ability§Grand Master of the Deathwing": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time a model in that unit makes an attack, if a Critical Hit is scored, that attack has the [PRECISION] ability."
      },
      "Ability§Grand Master of the Ravenwing": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, that unit is eligible to shoot and declare \na charge in a turn in which it Advanced. If that unit is already eligible to shoot and declare a charge in a turn in which it Advanced, add 1 to Advance and Charge rolls made for that unit instead."
      },
      "Ability§Honour or Death": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains a Company Champion, add 1 to Advance and Charge rolls made for this unit and you can target this unit with the Heroic Intervention Stratagem for 0CP."
      },
      "Ability§Icon of Old Caliban (aura)": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a friendly Adeptus Astartes unit is within 6″ of this model, models in that unit have the Stealth ability and each time a ranged attack targets that unit, that unit has the Benefit of Cover against that attack."
      },
      "Ability§Inner Circle": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack is allocated to a model in this unit, subtract 1 from the Damage characteristic of that attack."
      },
      "Ability§Intractable Will": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time a model in that unit is destroyed by a melee attack, if that model has not fought this phase, roll one D6. On a 4+, do not remove it from play; that destroyed model can fight after the attacking model’s unit has finished making its attacks, and is then removed from play."
      },
      "Ability§Knights of Caliban": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit is selected to fight, if it made a Charge move this turn, until the end of the phase, melee weapons equipped by models in this unit have the [ANTI-MONSTER 4+] and [ANTI-VEHICLE 4+] abilities."
      },
      "Ability§Lightning-fast Manoeuvres": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a ranged attack targets this model, subtract 1 from the Hit roll. If that attack was made by a model that can Fly, subtract 1 from the Wound roll as well."
      },
      "Ability§Martial Exemplar (Aura)": {
        "keywords": {
          "Keywords": [
            "Primarch",
            "Primarch of the First Legion"
          ]
        },
        "text": "While a friendly Adeptus Astartes unit is within 6″ of this model , each time a model in that unit makes a melee attack, re‑roll a Hit roll of 1 and re‑roll a Wound roll of 1"
      },
      "Ability§Master of Manoeuvre": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, when an enemy unit ends a Normal, Advance or Fall Back move within 9″ of this model, if this model is not within Engagement Range of one or more enemy units, this model can make a Normal move of up to 6″."
      },
      "Ability§Masterful Tactician": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of your Command phase, if this model is on the battlefield, you gain 1CP."
      },
      "Ability§Mist-wreathed Shadow Realms": {
        "keywords": {
          "Keywords": [
            "Primarch",
            "Primarch of the First Legion"
          ]
        },
        "text": "In your Command phase, if this unit is not within Engagement Range of one or more enemy units, you can remove it from the battlefield and place it into Strategic Reserves."
      },
      "Ability§Narthecium": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains an Apothecary, in your Command phase, you can return 1 destroyed model (excluding Character models) to this unit."
      },
      "Ability§No Hiding From the Watchers (Aura)": {
        "keywords": {
          "Keywords": [
            "Primarch",
            "Primarch of the First Legion"
          ]
        },
        "text": "While a friendly Adeptus Astartes unit is within 6″ of this model, models in that unit have the Feel No Pain 4+ ability against mortal wounds."
      },
      "Ability§Nowhere To Hide": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a friendly Adeptus Astartes Mounted or Adeptus Astartes Fly Vehicle unit is within 6″ of this model, ranged weapons equipped by models in that unit have the [IGNORES COVER] ability."
      },
      "Ability§Oath of Moment": {
        "keywords": {
          "Keywords": [
            "Faction"
          ]
        },
        "text": "If your Army Faction is Adeptus Astartes, at the start of your Command phase, select one unit from your opponent’s army. Until the start of your next Command phase, each time a model from your army with this ability makes an attack that targets that enemy unit, you can re-roll the Hit roll and you can re-roll the Wound roll."
      },
      "Ability§Primarch of the First Legion": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of your Command phase, select two Primarch of the First Legion abilities. Until the start of your next Command phase, this model has those abilities.\n\n**Mist-wreathed Shadow Realms:** In your Command phase, if this unit is not within Engagement Range of one or more enemy units, you can remove it from the battlefield and place it into Strategic Reserves.\n\n**Martial Exemplar (Aura):** While a friendly Adeptus Astartes unit is within 6\" of this model, each time a model in that unit makes a melee attack, re‑roll a Hit roll of 1 and re‑roll a Wound roll of 1.’\n\n**No Hiding From the Watchers (Aura):** While a friendly Adeptus Astartes unit is within 6″ of this model, models in that unit have the Feel No Pain 4+ ability against mortal wounds."
      },
      "Ability§Psychic Hood": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, models in that unit have the Feel No Pain 4+ ability against Psychic Attacks."
      },
      "Ability§Stasis Bomb": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, one model from your army with this ability can use it after it ends a normal move, if it does, you can select one enemy unit (excluding Aircraft) it moved over this phase. That unit suffers D3 mortal wounds and you must roll one D6: on a 1-3, that unit cannot Advance or Fall Back in your opponent’s next Movement phase; on a 4-6, that unit must Remain Stationary in your opponent’s next Movement phase."
      },
      "Ability§Storm of Vengeance": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, in your opponent’s Shooting phase, when another friendly Adeptus Astartes unit within 6″ of this model is destroyed, one model from your army with this ability can use it. If it does, after the attacking unit has finished making its attacks, that model can shoot as if it were your Shooting phase, but when resolving those attacks it can only target that enemy unit (and only if it is an eligible target)."
      },
      "Ability§Strikes of Retribution": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a melee attack is allocated to this model, after the attacking model’s unit has finished making its attacks, roll one D6 (to a maximum of six D6 per per attacking unit): for each 4+, the attacking unit suffers 1 mortal wound."
      },
      "Ability§Supreme Commander": {
        "keywords": {
          "Keywords": []
        },
        "text": ""
      },
      "Ability§Supreme Grand Master": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, weapons equipped by models in that unit have the [SUSTAINED HITS 1] ability."
      },
      "Ability§Tactical Precision": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, weapons equipped by models in that unit have the [LETHAL HITS] ability."
      },
      "Ability§Talonmaster": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is within 3″ of one or more other friendly Adeptus Astartes Mounted or Adeptus Astartes Fly Vehicle units, this model has the Lone Operative ability."
      },
      "Ability§The Emperor’s Shield": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack is allocated to this model, if the Strength characteristic of that attack is greater than the Toughness characteristic of this model, subtract 1 from the Wound roll."
      },
      "Ability§The Spiritshield Helm": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model has the Feel No Pain 3+ ability against Psychic Attacks and mortal wounds."
      },
      "Ability§The Unforgiven": {
        "text": "**The Ravenwing**\n\nThe following ADEPTUS ASTARTES units gain the RAVENWING keyword if they are drawn from the Dark Angels Chapter:\n\n- MOUNTED units\n- VEHICLE units that can FLY\n\n**The Deathwing**\n\nThe following ADEPTUS ASTARTES units gain the DEATHWING keyword if they are drawn from the Dark Angels Chapter:\n\n- TERMINATOR units\n- BLADEGUARD ANCIENT, BLADEGUARD VETERAN SQUAD, STERNGUARD VETERAN SQUAD and VANGUARD VETERAN SQUAD WITH JUMP PACKS units\n- LAND RAIDER, LAND RAIDER CRUSADER, LAND RAIDER REDEEMER, REPULSOR and REPULSOR EXECUTIONER units\n- DREADNOUGHT units"
      },
      "Ability§Vanquish the Foe": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack that targets an enemy unit that is Below Half-strength, add 1 to the Hit roll and add 1 to the Wound roll."
      },
