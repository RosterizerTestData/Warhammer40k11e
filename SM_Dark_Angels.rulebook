        "rules": {
          "1 in 3 Models can have a grenade launcher": {
            "evals": [
              {
                "actionable": true,
                "max": [
                  "{self}",
                  "rules",
                  "count1in3",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ],
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "tracked",
                    "grenade"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          },
          "applyGrenadelauncher": {
            "actions": [
              {
                "actionType": "modify",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "traits",
                    "item",
                    "Model§Ravenwing Black Knight",
                    "quantity"
                  ]
                ],
                "prepend": "",
                "value": [
                  "{this}",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ]
              },
              {
                "actionType": "add",
                "iterations": [
                  "{self}",
                  "stats",
                  "Grenade launcher",
                  "value"
                ],
                "paths": [
                  [
                    "{self}",
                    "traits"
                  ]
                ],
                "prepend": "",
                "value": {
                  "item": "Model§Ravenwing Black Knight",
                  "stats": {
                    "Ranged Options": {
                      "dynamic": false,
                      "value": "Astartes grenade launcher"
                    }
                  }
                }
              },
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Grenade launcher",
                    "max"
                  ]
                ],
                "value": [
                  "{self}",
                  "rules",
                  "count1in3",
                  "evals",
                  "0",
                  "result",
                  "integer"
                ]
              }
            ],
            "evals": [
              {
                "actionable": true,
                "equation": {
                  "operator": "T*O",
                  "value": -1
                },
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Grenade launcher",
                    "value"
                  ]
                ],
                "value": 0
              }
            ],
            "evaluate": "AND",
            "failState": "pass",
            "order": 100
          }
        },
