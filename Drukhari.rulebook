      "Wargear§Cluster Caltrops": {
        "text": "Each time you roll to inflict wounds using this unit’s Eviscerating Fly-by ability, you can re-roll one D6 for each model in this unit equipped with cluster caltrops."
      },
      "Wargear§Grav-talon": {
        "text": "The bearer’s melee weapons have an Armour Penetration characteristic of -2 and the [LETHAL HITS] ability."
      },
      "Wargear§Incubi Shrine Token": {
        "text": "Once per battle for each Aspect Shrine token this unit has, you can change the result of one Hit roll or one Wound roll made for a Klaivex or Incubi model in this unit to an unmodified 6."
      },
      "Wargear§Kabalite Icon": {
        "rules": {
          "apply": {
            "actions": [
              {
                "actionType": "modify",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "stats",
                    "OC",
                    "value"
                  ]
                ],
                "value": 1
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass",
            "order": 80
          }
        },
        "text": "While the bearer's unit is not Battle-shocked, add 1 to the bearer's Objective Control characteristic."
      },
      "Wargear§Phantasm Grenade Launcher": {
        "text": "The bearer’s unit has the Smoke and Grenades keyword."
      },
      "Wargear§Phantasm Grenade Launcher (HoA)": {
        "aspects": {
          "Label": "Phantasm Grenade Launcher"
        },
        "text": "The bearer’s unit has the Smoke keyword."
      },
      "Wargear§Shadowfield": {
        "text": "You cannot re-roll invulnerable saving throws made for the bearer. The first time an invulnerable saving throw made for the bearer is failed, until the end of the battle the bearer has no invulnerable save."
      },
      "Wargear§Soul Trap": {
        "text": "Add 1 to the Attacks and Strength characteristics of the bearer’s melee weapons. The first time the bearer makes a melee attack that destroys an enemy model, after all the bearer’s attacks have been resolved, until the end of the battle, add an additional 1 to the Attacks and Strength characteristics of the bearer’s melee weapons."
      },
      "Wargear§Stimm-needler": {
        "text": "Once per turn, the first time a saving throw is failed for a model in the bearer’s unit, change the Damage characteristic of that attack to 0."
      },
      "Stratagem§Shadows’ Reach": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **BLADES FOR HIRE/KABAL** unit has shot.\n\n**TARGET:** That **BLADES FOR HIRE/KABAL** unit.\n\n**EFFECT:** Those attacks do not prevent your unit from being **hidden**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Kabalite Agonysts"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Prioritised Victim": {
        "text": "**WHEN:** Your Shooting phase or the Fight phase, when a friendly **BLADES FOR HIRE/KABAL** unit targets a **CHARACTER** unit.\n\n**TARGET:** That **BLADES FOR HIRE/KABAL** unit.\n\n**EFFECT:** Your unit’s attacks that target a **CHARACTER** unit can:\n\n- Re-roll **hit rolls** of 1.\n\n- Re-roll **wound rolls** of 1.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Kabalite Agonysts"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight",
            "Shooting"
          ]
        }
      },
      "Stratagem§Killers from the Dark Spires": {
        "text": "**WHEN:** Your Shooting phase, when a friendly **KABALITE WARRIORS** unit is **selected to shoot**.\n\n**TARGET:** That **KABALITE WARRIORS** unit.\n\n**EFFECT:** Your unit’s ranged attacks have **[IGNORES COVER]**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Kabalite Agonysts"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Shooting"
          ]
        }
      },
      "Stratagem§Urgent Metamorphosis": {
        "text": "**WHEN:** Your Movement phase, when a friendly **HAEMONCULUS COVENS** unit is selected to make a **fall-back move**.\n\n**TARGET:** That **HAEMONCULUS COVENS** unit.\n\n**EFFECT:** That move does not prevent your unit from being **eligible to declare a charge**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Tools Of Torment"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        }
      },
      "Stratagem§Salting the Wound": {
        "text": "**WHEN:** Fight phase, when a friendly **CRONOS/TALOS** unit is **selected to fight**.\n\n**TARGET:** That **CRONOS/TALOS** unit.\n\n**EFFECT:** Your unit’s attacks that target a **battle-shocked** unit have **[DEVASTATING WOUNDS]**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Tools Of Torment"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Stratagem§Dividends of Agony": {
        "text": "**WHEN:** Fight phase, when a friendly **HAEMONCULUS COVENS** unit **destroys** an enemy unit.\n\n**TARGET:** That **HAEMONCULUS COVENS** unit.\n\n**EFFECT:** Select one **visible** enemy unit within 12\" of your unit. That enemy unit makes a **battle-shock** roll, with -1 to that **battle-shock roll**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Tools Of Torment"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Stratagem§Planned Strikes": {
        "text": "**WHEN:** Fight phase, when a friendly **WYCH CULT** unit is **selected to fight**.\n\n**TARGET:** That **WYCH CULT** unit.\n\n**EFFECT:** Your unit’s melee attacks have **[LETHAL HITS]**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Exhibition Of Slaughter"
          ],
          "Turn": [
            "Yours",
            "Opponent’s"
          ],
          "Phase": [
            "Fight"
          ]
        }
      },
      "Stratagem§Sculpting the Stage": {
        "text": "**WHEN:** Your Movement phase, when a friendly **WYCH CULT** unit is selected to make an **advance/fall-back move**.\n\n**TARGET:** That **WYCH CULT** unit.\n\n**EFFECT:** That move does not prevent your unit from being **eligible to start an action**.",
        "keywords": {
          "Keywords": [
            "Drukhari",
            "Exhibition Of Slaughter"
          ],
          "Turn": [
            "Yours"
          ],
          "Phase": [
            "Movement"
          ]
        }
      },
